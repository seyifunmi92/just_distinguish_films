# Public site URL (used for canonical links, Open Graph and the sitemap)
NEXT_PUBLIC_SITE_URL=https://justdistinguishfilms.com

# Contact form email delivery via Resend (https://resend.com)
# Without these two, the form opens the visitor's email app with the message pre-filled instead.
RESEND_API_KEY=
# Must be an address on a domain you have verified in Resend, e.g. "Just Distinguish Films <hello@justdistinguishfilms.com>"
CONTACT_FROM_EMAIL=
